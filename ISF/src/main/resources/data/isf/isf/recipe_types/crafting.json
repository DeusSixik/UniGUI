{
  "parameters": {
    "result": {
      "type": "item",
      "default": "minecraft:air",
      "description": "Result item"
    },
    "result_count": {
      "type": "number",
      "default": 1
    },
    "ingredients": {
      "type": "json",
      "default": []
    },
    "width": {
      "type": "number",
      "default": 3
    },
    "height": {
      "type": "number",
      "default": 3
    },
    "pattern": {
      "type": "json",
      "default": []
    }
  },
  "visual": {
    "id": "root",
    "widget": "unigui:box",
    "properties": {
      "width": 176,
      "height": 92,
      "background": "#11151DEB",
      "border": "#6A8FAEFF",
      "radius": 3
    },
    "children": [
      {
        "id": "body",
        "widget": "unigui:hbox",
        "properties": {
          "padding": 12,
          "spacing": 10,
          "alignItems": "center"
        },
        "children": [
          {
            "id": "ingredients",
            "widget": "isf:ingredient_grid",
            "properties": {
              "items": { "$parameter": "pattern" }
            }
          },
          {
            "id": "arrow",
            "widget": "unigui:label",
            "properties": {
              "text": ">",
              "width": 18,
              "height": 24,
              "alignSelf": "center"
            }
          },
          {
            "id": "result",
            "widget": "unigui:item",
            "properties": {
              "item": { "$parameter": "result" },
              "count": { "$parameter": "result_count" },
              "width": 24,
              "height": 24,
              "alignSelf": "center"
            }
          }
        ]
      }
    ]
  }
}
