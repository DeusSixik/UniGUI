<?xml version="1.0" encoding="UTF-8"?>
<Box id="reactorPanel"
     width="560"
     height="430"
     align="center"
     padding="12"
     background="#0B101DF2"
     border="#4A7DFFE6"
     borderWidth="1"
     radius="8"
     themeEnabled="false">

    <VBox id="layout"
          rowGap="10"
          columnGap="10"
          alignItems="stretch"
          flexGrow="1"
          flexShrink="1">

        <HBox id="header"
              rowGap="8"
              columnGap="8"
              alignItems="center"
              height="34"
              flexGrow="0"
              flexShrink="0">

            <Box id="coreIcon"
                 width="28"
                 height="28"
                 background="#12315DEB"
                 border="#7DFFB1FF"
                 borderWidth="2"
                 radius="14"
                 flexGrow="0"
                 flexShrink="0" />

            <VBox id="headerText"
                  rowGap="2"
                  columnGap="2"
                  width="372"
                  flexGrow="0"
                  flexShrink="0">

                <Label id="title"
                       text="Aurora Reactor Control"
                       color="#EAF4FFFF"
                       height="18"
                       flexGrow="0"
                       flexShrink="0" />

                <TextBlock id="body"
                           text="Experimental energy core dashboard"
                           color="#8FB7FFFF"
                           height="14"
                           wrap="true"
                           overflowMode="clip"
                           flexGrow="0"
                           flexShrink="0" />
            </VBox>

            <Checkbox id="strict"
                      text="Strict XML"
                      checked="true"
                      width="120"
                      height="20"
                      flexGrow="0"
                      flexShrink="0" />
        </HBox>

        <Box id="headerDivider"
             height="1"
             background="#33475CBF"
             flexGrow="0"
             flexShrink="0" />

        <WrapPanel id="metricCards"
                   rowGap="8"
                   columnGap="8"
                   flexGrow="0"
                   flexShrink="0">

            <Box id="temperatureCard"
                 width="126"
                 minHeight="104"
                 background="#0F1728EB"
                 border="#3D5A8FFF"
                 borderWidth="1"
                 radius="6"
                 themeEnabled="false">

                <VBox rowGap="4"
                      columnGap="4"
                      margin="8"
                      alignItems="stretch"
                      flexGrow="0"
                      flexShrink="0">

                    <Label text="Temperature"
                           color="#9BD9FFFF"
                           height="16"
                           flexGrow="0"
                           flexShrink="0" />

                    <TextBlock text="Core heat is stable but needs monitoring during burst phase."
                               color="#B9C7D9FF"
                               width="110"
                               height="36"
                               wrap="true"
                               overflowMode="clip"
                               flexGrow="0"
                               flexShrink="0" />

                    <ProgressBar id="temperatureBar"
                                 min="0"
                                 max="100"
                                 value="58"
                                 height="10"
                                 fillColor="#FFB454FF"
                                 flexGrow="0"
                                 flexShrink="0" />
                </VBox>
            </Box>

            <Box id="energyCard"
                 width="126"
                 minHeight="104"
                 background="#0F1728EB"
                 border="#3D5A8FFF"
                 borderWidth="1"
                 radius="6"
                 themeEnabled="false">

                <VBox rowGap="4"
                      columnGap="4"
                      margin="8"
                      alignItems="stretch"
                      flexGrow="0"
                      flexShrink="0">

                    <Label text="Energy"
                           color="#9BD9FFFF"
                           height="16"
                           flexGrow="0"
                           flexShrink="0" />

                    <TextBlock text="Output buffer is charging from residual plasma flow."
                               color="#B9C7D9FF"
                               width="110"
                               height="36"
                               wrap="true"
                               overflowMode="clip"
                               flexGrow="0"
                               flexShrink="0" />

                    <ProgressBar id="energyBar"
                                 min="0"
                                 max="100"
                                 value="74"
                                 height="10"
                                 fillColor="#52D273FF"
                                 flexGrow="0"
                                 flexShrink="0" />
                </VBox>
            </Box>

            <Box id="fuelCard"
                 width="126"
                 minHeight="104"
                 background="#0F1728EB"
                 border="#3D5A8FFF"
                 borderWidth="1"
                 radius="6"
                 themeEnabled="false">

                <VBox rowGap="4"
                      columnGap="4"
                      margin="8"
                      alignItems="stretch"
                      flexGrow="0"
                      flexShrink="0">

                    <Label text="Fuel"
                           color="#9BD9FFFF"
                           height="16"
                           flexGrow="0"
                           flexShrink="0" />

                    <TextBlock text="Fuel rods are at partial capacity. Replace after cycle."
                               color="#B9C7D9FF"
                               width="110"
                               height="36"
                               wrap="true"
                               overflowMode="clip"
                               flexGrow="0"
                               flexShrink="0" />

                    <ProgressBar id="fuelBar"
                                 min="0"
                                 max="100"
                                 value="41"
                                 height="10"
                                 fillColor="#F2D25BFF"
                                 flexGrow="0"
                                 flexShrink="0" />
                </VBox>
            </Box>

            <Box id="shieldCard"
                 width="126"
                 minHeight="104"
                 background="#0F1728EB"
                 border="#3D5A8FFF"
                 borderWidth="1"
                 radius="6"
                 themeEnabled="false">

                <VBox rowGap="4"
                      columnGap="4"
                      margin="8"
                      alignItems="stretch"
                      flexGrow="0"
                      flexShrink="0">

                    <Label text="Shield"
                           color="#9BD9FFFF"
                           height="16"
                           flexGrow="0"
                           flexShrink="0" />

                    <TextBlock text="Deflector grid holds strong under current load."
                               color="#B9C7D9FF"
                               width="110"
                               height="36"
                               wrap="true"
                               overflowMode="clip"
                               flexGrow="0"
                               flexShrink="0" />

                    <ProgressBar id="shieldBar"
                                 min="0"
                                 max="100"
                                 value="87"
                                 height="10"
                                 fillColor="#66A9FFFF"
                                 flexGrow="0"
                                 flexShrink="0" />
                </VBox>
            </Box>
        </WrapPanel>

        <Box id="controlsCard"
             background="#0C1222E6"
             border="#33475CBF"
             borderWidth="1"
             radius="6"
             themeEnabled="false"
             flexGrow="0"
             flexShrink="0">

            <VBox rowGap="8"
                  columnGap="8"
                  margin="10"
                  alignItems="stretch"
                  flexGrow="0"
                  flexShrink="0">

                <HBox rowGap="8"
                      columnGap="8"
                      alignItems="center"
                      height="18"
                      flexGrow="0"
                      flexShrink="0">

                    <Label text="Power Limit"
                           color="#D6E6FFFF"
                           width="90"
                           height="16"
                           flexGrow="0"
                           flexShrink="0" />

                    <Slider id="amount"
                            min="0"
                            max="100"
                            value="42"
                            step="1"
                            width="300"
                            height="16"
                            flexGrow="0"
                            flexShrink="0" />

                    <Label id="powerValue"
                           text="42%"
                           color="#7DFFB1FF"
                           width="36"
                           height="16"
                           flexGrow="0"
                           flexShrink="0" />
                </HBox>

                <ProgressBar id="meter"
                             min="0"
                             max="100"
                             value="42"
                             height="10"
                             fillColor="#52D273FF"
                             flexGrow="0"
                             flexShrink="0" />

                <HBox id="controlsRow"
                      rowGap="8"
                      columnGap="8"
                      justifyContent="center"
                      height="26"
                      flexGrow="0"
                      flexShrink="0">

                    <Button id="apply"
                            text="Apply"
                            width="86"
                            height="24" />

                    <ToggleButton id="autoTune"
                                  text="Auto Tune"
                                  width="110"
                                  height="24" />

                    <Button id="cycle"
                            text="Cycle"
                            width="86"
                            height="24" />

                    <Button id="close"
                            text="Close"
                            width="86"
                            height="24" />
                </HBox>
            </VBox>
        </Box>

        <Box id="logCard"
             minHeight="104"
             background="#080C16E0"
             border="#27405FBF"
             borderWidth="1"
             radius="6"
             overflow="hidden"
             themeEnabled="false"
             flexGrow="0"
             flexShrink="0">

            <VBox rowGap="6"
                  columnGap="6"
                  margin="8"
                  alignItems="stretch"
                  flexGrow="1"
                  flexShrink="1">

                <Label text="Event Log"
                       color="#93A9C9FF"
                       height="16"
                       flexGrow="0"
                       flexShrink="0" />

                <TextBlock id="logText"
                           text="Core initialized. Coolant pressure normalized. Safe mode enabled. Waiting for operator command."
                           color="#7FD3FFFF"
                           width="504"
                           height="56"
                           wrap="true"
                           overflowMode="clip"
                           flexGrow="0"
                           flexShrink="0" />
            </VBox>
        </Box>

        <Label id="status"
               text="Status: STANDBY"
               color="#75D7FFFF"
               height="18"
               flexGrow="0"
               flexShrink="0" />
    </VBox>
</Box>